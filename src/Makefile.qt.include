XPCHAIN_QT_CPP = $(XPCHAIN_QT_BASE_CPP)
if TARGET_WINDOWS
XPCHAIN_QT_CPP += $(XPCHAIN_QT_WINDOWS_CPP)
endif
if ENABLE_WALLET
XPCHAIN_QT_CPP += $(XPCHAIN_QT_WALLET_CPP)
endif

RES_IMAGES =

RES_MOVIES = $(wildcard $(srcdir)/qt/res/movies/spinner-*.png)

XPCHAIN_RC = qt/res/xpchain-qt-res.rc

XPCHAIN_QT_INCLUDES = -DQT_NO_KEYWORDS

qt_libxpchainqt_a_CPPFLAGS = $(AM_CPPFLAGS) $(XPCHAIN_INCLUDES) $(XPCHAIN_QT_INCLUDES) \
  $(QT_INCLUDES) $(QT_DBUS_INCLUDES) $(PROTOBUF_CFLAGS) $(QR_CFLAGS)
qt_libxpchainqt_a_CXXFLAGS = $(AM_CXXFLAGS) $(QT_PIE_FLAGS)
qt_libxpchainqt_a_OBJCXXFLAGS = $(AM_OBJCXXFLAGS) $(QT_PIE_FLAGS)

qt_libxpchainqt_a_SOURCES = $(XPCHAIN_QT_CPP) $(XPCHAIN_QT_H) $(QT_FORMS_UI) \
  $(QT_QRC) $(QT_QRC_LOCALE) $(QT_TS) $(PROTOBUF_PROTO) $(RES_ICONS) $(RES_IMAGES) $(RES_MOVIES)

nodist_qt_libxpchainqt_a_SOURCES = $(QT_MOC_CPP) $(QT_MOC) $(PROTOBUF_CC) \
  $(PROTOBUF_H) $(QT_QRC_CPP) $(QT_QRC_LOCALE_CPP)

# forms/foo.h -> forms/ui_foo.h
QT_FORMS_H=$(join $(dir $(QT_FORMS_UI)),$(addprefix ui_, $(notdir $(QT_FORMS_UI:.ui=.h))))

# Most files will depend on the forms and moc files as includes. Generate them
# before anything else.
$(QT_MOC): $(QT_FORMS_H)
$(qt_libxpchainqt_a_OBJECTS) $(qt_xpchain_qt_OBJECTS) : | $(QT_MOC)

#Generating these with a half-written protobuf header leads to wacky results.
#This makes sure it's done.
$(QT_MOC): $(PROTOBUF_H)
$(QT_MOC_CPP): $(PROTOBUF_H)

# xpchain-qt binary #
qt_xpchain_qt_CPPFLAGS = $(AM_CPPFLAGS) $(XPCHAIN_INCLUDES) $(XPCHAIN_QT_INCLUDES) \
  $(QT_INCLUDES) $(PROTOBUF_CFLAGS) $(QR_CFLAGS)
qt_xpchain_qt_CXXFLAGS = $(AM_CXXFLAGS) $(QT_PIE_FLAGS)

qt_xpchain_qt_SOURCES = qt/xpchain.cpp
if TARGET_DARWIN
  qt_xpchain_qt_SOURCES += $(XPCHAIN_MM)
endif
if TARGET_WINDOWS
  qt_xpchain_qt_SOURCES += $(XPCHAIN_RC)
endif
qt_xpchain_qt_LDADD = qt/libxpchainqt.a $(LIBXPCHAIN_SERVER)
if ENABLE_WALLET
qt_xpchain_qt_LDADD += $(LIBXPCHAIN_UTIL) $(LIBXPCHAIN_WALLET) $(LIBXPCHAIN_SERVER)
endif
if ENABLE_ZMQ
qt_xpchain_qt_LDADD += $(LIBXPCHAIN_ZMQ) $(ZMQ_LIBS)
endif
qt_xpchain_qt_LDADD += $(LIBXPCHAIN_CLI) $(LIBXPCHAIN_COMMON) $(LIBXPCHAIN_UTIL) $(LIBXPCHAIN_CONSENSUS) $(LIBXPCHAIN_CRYPTO) $(LIBUNIVALUE) $(LIBLEVELDB) $(LIBLEVELDB_SSE42) $(LIBMEMENV) \
  $(BOOST_LIBS) $(QT_LIBS) $(QT_DBUS_LIBS) $(QR_LIBS) $(PROTOBUF_LIBS) $(BDB_LIBS) $(SSL_LIBS) $(CRYPTO_LIBS) $(MINIUPNPC_LIBS) $(LIBSECP256K1) \
  $(EVENT_PTHREADS_LIBS) $(EVENT_LIBS) $(SQLITE3_LIBS)
qt_xpchain_qt_LDFLAGS = $(RELDFLAGS) $(AM_LDFLAGS) $(QT_LDFLAGS) $(LIBTOOL_APP_LDFLAGS)
qt_xpchain_qt_LIBTOOLFLAGS = $(AM_LIBTOOLFLAGS) --tag CXX

#locale/foo.ts -> locale/foo.qm
QT_QM=$(QT_TS:.ts=.qm)

SECONDARY: $(QT_QM)

$(srcdir)/qt/xpchainstrings.cpp: $(libxpchain_server_a_SOURCES) $(libxpchain_wallet_a_SOURCES) $(libxpchain_common_a_SOURCES) $(libxpchain_zmq_a_SOURCES) $(libxpchain_consensus_a_SOURCES) $(libxpchain_util_a_SOURCES)
	@test -n $(XGETTEXT) || echo "xgettext is required for updating translations"
	$(AM_V_GEN) cd $(srcdir); XGETTEXT=$(XGETTEXT) PACKAGE_NAME="$(PACKAGE_NAME)" COPYRIGHT_HOLDERS="$(COPYRIGHT_HOLDERS)" COPYRIGHT_HOLDERS_SUBSTITUTION="$(COPYRIGHT_HOLDERS_SUBSTITUTION)" $(PYTHON) ../share/qt/extract_strings_qt.py $^

translate: $(srcdir)/qt/xpchainstrings.cpp $(QT_FORMS_UI) $(QT_FORMS_UI) $(XPCHAIN_QT_BASE_CPP) qt/xpchain.cpp $(XPCHAIN_QT_WINDOWS_CPP) $(XPCHAIN_QT_WALLET_CPP) $(XPCHAIN_QT_H) $(XPCHAIN_MM)
	@test -n $(LUPDATE) || echo "lupdate is required for updating translations"
	$(AM_V_GEN) QT_SELECT=$(QT_SELECT) $(LUPDATE) $^ -locations relative -no-obsolete -ts $(srcdir)/qt/locale/xpchain_en.ts

$(QT_QRC_LOCALE_CPP): $(QT_QRC_LOCALE) $(QT_QM)
	@test -f $(RCC)
	@cp -f $< $(@D)/temp_$(<F)
	$(AM_V_GEN) QT_SELECT=$(QT_SELECT) $(RCC) -name xpchain_locale $(@D)/temp_$(<F) | \
	  $(SED) -e '/^\*\*.*Created:/d' -e '/^\*\*.*by:/d' > $@
	@rm $(@D)/temp_$(<F)

$(QT_QRC_CPP): $(QT_QRC) $(QT_FORMS_H) $(RES_ICONS) $(RES_IMAGES) $(RES_MOVIES) $(PROTOBUF_H)
	@test -f $(RCC)
	$(AM_V_GEN) QT_SELECT=$(QT_SELECT) $(RCC) -name xpchain $< | \
	  $(SED) -e '/^\*\*.*Created:/d' -e '/^\*\*.*by:/d' > $@

CLEAN_QT = $(nodist_qt_libxpchainqt_a_SOURCES) $(QT_QM) $(QT_FORMS_H) qt/*.gcda qt/*.gcno qt/temp_xpchain_locale.qrc

CLEANFILES += $(CLEAN_QT)

xpchain_qt_clean: FORCE
	rm -f $(CLEAN_QT) $(qt_libxpchainqt_a_OBJECTS) $(qt_xpchain_qt_OBJECTS) qt/xpchain-qt$(EXEEXT) $(LIBXPCHAIN_QT)

xpchain_qt : qt/xpchain-qt$(EXEEXT)

ui_%.h: %.ui
	@test -f $(UIC)
	@$(MKDIR_P) $(@D)
	$(AM_V_GEN) QT_SELECT=$(QT_SELECT) $(UIC) -o $@ $< || (echo "Error creating $@"; false)

%.moc: %.cpp
	$(AM_V_GEN) QT_SELECT=$(QT_SELECT) $(MOC) $(DEFAULT_INCLUDES) $(QT_INCLUDES) $(MOC_DEFS) $< | \
	  $(SED) -e '/^\*\*.*Created:/d' -e '/^\*\*.*by:/d' > $@

moc_%.cpp: %.h
	$(AM_V_GEN) QT_SELECT=$(QT_SELECT) $(MOC) $(DEFAULT_INCLUDES) $(QT_INCLUDES) $(MOC_DEFS) $< | \
	  $(SED) -e '/^\*\*.*Created:/d' -e '/^\*\*.*by:/d' > $@

%.qm: %.ts
	@test -f $(LRELEASE)
	@$(MKDIR_P) $(@D)
	$(AM_V_GEN) QT_SELECT=$(QT_SELECT) $(LRELEASE) -silent $< -qm $@
